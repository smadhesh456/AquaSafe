# AquaSafe Environment Configuration Example
# Copy this file to .env or set environment variables in your deployment environment

# Server Port
PORT=8080

# Database Configuration (MySQL 8.x)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=aquasafe
DB_USER=root
DB_PASSWORD=root
DB_FALLBACK_H2=true

# External APIs and Official Government Portal Configurations
# Note: Open-Meteo free public tier does not require an API key
OPEN_METEO_API_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive

# Government Portal Placeholders (Set if access token / subscription key is provided)
CPCB_API_KEY=
TNPCB_API_KEY=
IDSP_API_KEY=
NCDC_API_KEY=
CENSUS_API_KEY=
JAL_JEEVAN_API_KEY=

# Data Freshness & Ingestion Thresholds (Hours)
DATA_FRESHNESS_HOURS=24

# Spark & Big Data Engine (Local fallback active by default)
SPARK_MASTER=local[*]
HADOOP_HDFS_URI=hdfs://localhost:9000

# Security Credentials
JWT_SECRET=aquasafe_super_secret_jwt_key_2026_water_borne_disease_risk_analytics
